{
  "name": "vulntruth",
  "version": "0.1.0",
  "private": true,
  "description": "Scanner-neutral vulnerability disagreement and decision evidence engine",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "analyze": "node apps/cli/src/index.js analyze",
    "demo": "node apps/cli/src/index.js demo",
    "test": "node --test tests/*.test.js",
    "verify": "npm run test && npm run demo"
  },
  "engines": {
    "node": ">=20"
  }
}
