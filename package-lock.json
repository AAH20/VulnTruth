{
  "name": "vulntruth",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "vulntruth",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/action": {
      "name": "@vulntruth/action",
      "version": "0.1.0"
    },
    "apps/cli": {
      "name": "@vulntruth/cli",
      "version": "0.1.0",
      "dependencies": {
        "@vulntruth/adapters": "0.1.0",
        "@vulntruth/engine": "0.1.0",
        "@vulntruth/report": "0.1.0"
      },
      "bin": {
        "vulntruth": "src/index.js"
      }
    },
    "node_modules/@vulntruth/action": {
      "resolved": "apps/action",
      "link": true
    },
    "node_modules/@vulntruth/adapters": {
      "resolved": "packages/adapters",
      "link": true
    },
    "node_modules/@vulntruth/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@vulntruth/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/@vulntruth/report": {
      "resolved": "packages/report",
      "link": true
    },
    "node_modules/@vulntruth/schema": {
      "resolved": "packages/schema",
      "link": true
    },
    "packages/adapters": {
      "name": "@vulntruth/adapters",
      "version": "0.1.0",
      "dependencies": {
        "@vulntruth/schema": "0.1.0"
      }
    },
    "packages/engine": {
      "name": "@vulntruth/engine",
      "version": "0.1.0",
      "dependencies": {
        "@vulntruth/schema": "0.1.0"
      }
    },
    "packages/report": {
      "name": "@vulntruth/report",
      "version": "0.1.0"
    },
    "packages/schema": {
      "name": "@vulntruth/schema",
      "version": "0.1.0"
    }
  }
}
